# Environment / secrets — never commit
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Generated artifacts (charts are rendered at runtime, not committed).
# NOTE: no blanket *.png — M3 ships chart fixtures and journal/ may reference images.
/charts_out/
sentinel/**/*.png

# OS
.DS_Store

# `make check-wheel` output — a build artifact, never committed.
.build-wheel/

# Local rehearsal of the backup cron (docs/DEPLOY.md §7). Database dumps are
# the one thing in this repo that must never reach a remote.
/backups/
