# Sentinel — environment / secrets template.
# Copy to .env and fill in.   cp .env.example .env
#
# ─────────────────────────────────────────────────────────────────────────────
#  NO EXCHANGE API KEYS. EVER.
#  v1 has no execution path: no order placement, no trade- or withdraw-scoped
#  credentials, not "for later". All Binance market data is public and keyless.
#  (CLAUDE.md hard constraint · PRD.md §3)
# ─────────────────────────────────────────────────────────────────────────────

# --- Runtime ---------------------------------------------------------------
SENTINEL_ENV=dev                 # dev → human-readable logs | prod → JSON logs
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
HEALTH_HOST=0.0.0.0              # bind INSIDE the container; Compose controls exposure
HEALTH_PORT=8000                 # port INSIDE the container — leave it alone
CONFIG_PATH=config.yaml

# --- Host ports (docs/DEPLOY.md §3) -----------------------------------------
# The HOST side of the /health publish. Bound to 127.0.0.1 by docker-compose.yml,
# because Sentinel needs no inbound port at all (Telegram is long polling, i.e.
# outbound) and the target server runs somebody else's app on the usual ones.
# Change this if 18080 is taken:  ss -ltnp | grep 18080
SENTINEL_HTTP_PORT=18080

# Local development only: the port docker-compose.dev.yml publishes Postgres on,
# for `make run`, alembic and the sentinel.tools.* CLIs. The SERVER publishes no
# database port at all — that file is never used there.
POSTGRES_HOST_PORT=5432

# Compose project name — containers and volumes are prefixed with it. The server
# gets `sentinel` from docker-compose.yml's `name:` key. Set this only to KEEP an
# existing local project's volumes after that key was added, e.g. a laptop whose
# data lives in ai-trader_pgdata:
# COMPOSE_PROJECT_NAME=ai-trader

# --- Postgres --------------------------------------------------------------
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sentinel

# The HOST-facing URL: what `make run`, `alembic`, and every `python -m
# sentinel.tools.*` command use ON A DEVELOPMENT MACHINE, where
# docker-compose.dev.yml publishes Postgres on 127.0.0.1.
#
# On the SERVER nothing reads this value. docker-compose.yml publishes no
# database port at all (the host's 5432 belongs to another application) and
# overrides DATABASE_URL for the app service with the Compose network address,
# which only resolves inside the network. There, run CLI commands through the
# container instead:  docker compose run --rm --no-deps app python -m sentinel.tools.stats
DATABASE_URL=postgresql+asyncpg://sentinel:change-me@localhost:5432/sentinel

# Round-trip tests against a REAL Postgres. Opt-in, and DESTRUCTIVE: the suite
# truncates the tables it asserts counts on. Point it at its own database, never
# at the one above — see tests/bot/test_persistence.py.
#   docker compose exec postgres createdb -U sentinel sentinel_test
# SENTINEL_TEST_DATABASE_URL=postgresql+asyncpg://sentinel:change-me@localhost:5432/sentinel_test

# --- Anthropic (screener + deep analyst) ------------------------------------
ANTHROPIC_API_KEY=

# --- Telegram (specs/TELEGRAM_UX.md) ----------------------------------------
TELEGRAM_BOT_TOKEN=

# YOUR numeric Telegram user id. This is the one identity that cannot be granted
# from inside Telegram: it names the OWNER row, the only account that can approve,
# reject or suspend anybody, and the only destination for spend and failure alerts.
#
# Required. Migration 0007 refuses to run without it on a database that has data to
# attribute, rather than guessing and handing your signals to somebody else. Find it
# by messaging @userinfobot.
TELEGRAM_OWNER_USER_ID=

# The pre-M8.1 allowlist. Membership now lives in the `users` table, where a person
# can be added with a button instead of a deploy (specs/TELEGRAM_UX.md §7). This
# survives only as a fallback for TELEGRAM_OWNER_USER_ID, and only when it holds
# EXACTLY ONE id — a longer list predates roles and says nothing about who owns the
# system, so it is not guessed from.
TELEGRAM_ALLOWED_USER_IDS=

# --- News (specs/DATA_SOURCES.md §2.2) --------------------------------------
# Optional: without it, ingestion falls back to RSS and marks the source degraded.
CRYPTOPANIC_API_KEY=

# --- Saxo Bank OpenAPI (M10b, docs/specs/FOREX.md §3) -----------------------
#
# Forex market data. UNUSED while markets.forex.enabled is false, which is how this
# release ships — leave these blank and nothing changes.
#
# Create the app at https://www.developer.saxo/ with the TRADING CHECKBOX UNCHECKED.
# Sentinel has no execution path and must hold no credential that could place an
# order (CLAUDE.md), and an unchecked box is a stronger guarantee than a promise.
SAXO_APP_KEY=
SAXO_APP_SECRET=

# BOOTSTRAP ONLY, and it goes stale by design. Obtained once by logging in at the
# authorize URL on your own Mac and copying the code that lands on the redirect
# below. Sentinel exchanges it, and from then on the live credential lives in
# Postgres — the refresh token is SINGLE USE and rotates on every refresh, so this
# value is spent within minutes of the first start and is never written back to.
#
# It is used only to seed an EMPTY token store. If Postgres already holds a
# credential, that one wins: letting a redeploy overwrite the live chain with this
# spent value would end the chain and force the very login it is here to avoid.
SAXO_REFRESH_TOKEN=

# Where the authorization code lands during that manual login. localhost on your own
# machine, deliberately — it keeps the server's zero-inbound-ports property intact.
SAXO_REDIRECT_URI=https://localhost:8080/callback

# NOTE, because it is an operational cost and not a footnote: the refresh chain has a
# ONE-HOUR MEMORY. The access token lives ~20 minutes and the refresh token ~1 hour,
# and each refresh resets that hour. A deploy or restart inside the hour survives;
# any outage longer than an hour needs a fresh browser login by hand. There is no
# unattended credential at this account tier — Saxo's Certificate Based
# Authentication is the only server-to-server option and it is partners-only.

# --- Host ops scripts (ops/*.sh, installed by docs/DEPLOY.md) ---------------
# Read by the backup, restore and watchdog scripts. They are host-side and not
# app config, but they live here so a deployment has exactly one file to fill in.
# Where pg_dump writes. Must exist and be writable by whoever runs the cron.
BACKUP_DIR=/opt/sentinel/backups
# Dumps older than this are pruned. The newest 3 always survive, whatever it says.
BACKUP_RETENTION_DAYS=14
# Consecutive failed /health probes before the watchdog messages you. At the
# suggested 15-minute cron, 3 is ~45 minutes of being down.
WATCHDOG_FAILURES_BEFORE_ALERT=3
