# Sentinel — environment / secrets template.
# Copy to .env and fill in.   cp .env.example .env
#
# ─────────────────────────────────────────────────────────────────────────────
#  NO EXCHANGE API KEYS. EVER.
#  v1 has no execution path: no order placement, no trade- or withdraw-scoped
#  credentials, not "for later". All Binance market data is public and keyless.
#  (CLAUDE.md hard constraint · PRD.md §3)
# ─────────────────────────────────────────────────────────────────────────────

# --- Runtime ---------------------------------------------------------------
SENTINEL_ENV=dev                 # dev → human-readable logs | prod → JSON logs
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
HEALTH_HOST=0.0.0.0
HEALTH_PORT=8000
CONFIG_PATH=config.yaml

# --- Postgres --------------------------------------------------------------
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sentinel

# Host `postgres` = the Compose service name. For running outside Docker
# (make run / make test), use: postgresql+asyncpg://sentinel:change-me@localhost:5432/sentinel
DATABASE_URL=postgresql+asyncpg://sentinel:change-me@postgres:5432/sentinel

# --- Anthropic (screener + deep analyst) ------------------------------------
ANTHROPIC_API_KEY=

# --- Telegram (specs/TELEGRAM_UX.md) ----------------------------------------
TELEGRAM_BOT_TOKEN=
# Numeric user id allowlist, comma-separated. Everyone else gets silence.
TELEGRAM_ALLOWED_USER_IDS=

# --- News (specs/DATA_SOURCES.md §2.2) --------------------------------------
# Optional: without it, ingestion falls back to RSS and marks the source degraded.
CRYPTOPANIC_API_KEY=
